@page
@model PusulaSu.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Hesabım";
    ViewData["ActivePage"] = PusulaSu.Areas.Identity.Pages.Account.Manage.ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
@* Abone bilgileri yalnızca görüntülenir, buradan değiştirilemez. *@
@if (Model.Abone != null)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <div class="mb-4">
                <span class="badge rounded-pill text-bg-info">
                    Abonelik Bilgileri
                </span>

                <h2 class="h4 mt-3 mb-1">
                    @Model.Abone.AdSoyad
                </h2>

                <p class="text-muted mb-0">
                    Sisteme bağlı abonelik bilgileriniz
                </p>
            </div>

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100">
                        <small class="text-muted d-block mb-1">
                            Abone Numarası
                        </small>

                        <strong>@Model.Abone.AboneNo</strong>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100">
                        <small class="text-muted d-block mb-1">
                            Sayaç Numarası
                        </small>

                        <strong>@Model.Abone.SayacNo</strong>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100">
                        <small class="text-muted d-block mb-1">
                            Abone Türü
                        </small>

                        <strong>@Model.Abone.AboneTuru</strong>
                    </div>
                </div>

            </div>
        </div>
    </div>
}
@* Kullanıcının değiştirebileceği iletişim bilgileri. *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <div class="mb-4">
            <h2 class="h4 mb-1">İletişim Bilgileri</h2>

            <p class="text-muted mb-0">
                Size ulaşılabilecek telefon numarasını güncelleyin.
            </p>
        </div>

        <form id="profile-form" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert">
            </div>

            <div class="row align-items-end g-3">

                <div class="col-md-8">
                    <label asp-for="Input.PhoneNumber"
                           class="form-label fw-semibold">
                        Telefon Numarası
                    </label>

                    <input asp-for="Input.PhoneNumber"
                           class="form-control"
                           placeholder="Örneğin: 05XX XXX XX XX" />

                    <span asp-validation-for="Input.PhoneNumber"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4">
                    <button id="update-profile-button"
                            type="submit"
                            class="btn btn-primary w-100">
                        Bilgileri Güncelle
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
