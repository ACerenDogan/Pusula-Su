@model PusulaSu.Models.AboneKaydi

@{
    ViewData["Title"] = "Hesabım";
}

<div class="mx-auto py-4" style="max-width: 900px;">

    <!-- Sayfa başlığı -->
    <div class="mb-4">
        <span class="badge rounded-pill account-kicker mb-2">
            ABONELİK ÖZETİ
        </span>

        <h1 class="display-6 fw-bold mb-2">Hesabım</h1>

        <p class="text-muted mb-0">
            Abonelik ve sayaç bilgilerinizi güvenli şekilde görüntüleyin.
        </p>
    </div>

    <!-- Abone bilgi kartı -->
    <div class="card account-card border-0 shadow-sm overflow-hidden">

        <!-- Kartın üst bölümü -->
        <div class="account-card-header p-4">
            <div class="d-flex flex-column flex-sm-row
                        align-items-sm-center justify-content-between gap-3">

                <div class="d-flex align-items-center gap-3">
                    <div class="account-profile-icon">
                        <span>PS</span>
                    </div>

                    <div>
                        <p class="text-muted small mb-1">
                            Abone sahibi
                        </p>

                        <h2 class="h4 fw-bold mb-0">
                            @Model.AdSoyad
                        </h2>
                    </div>
                </div>

                <span class="account-status">
                    <span class="account-status-dot"></span>
                    Aktif Abonelik
                </span>
            </div>
        </div>

        <!-- Abonelik ayrıntıları -->
        <div class="card-body p-4">
            <div class="row g-3">

                <div class="col-md-6">
                    <div class="account-detail">
                        <span>Abone Numarası</span>
                        <strong>@Model.AboneNo</strong>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="account-detail">
                        <span>Sayaç Numarası</span>
                        <strong>@Model.SayacNo</strong>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="account-detail">
                        <span>Abone Türü</span>
                        <strong>@Model.AboneTuru</strong>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="account-detail">
                        <span>Hesap Durumu</span>
                        <strong class="text-success">Kullanıma Açık</strong>
                    </div>
                </div>

            </div>
        </div>
    </div>

<!-- HESAP İŞLEMLERİ -->
<section class="account-management">

    <div class="account-management-header">
        <span>HESAP İŞLEMLERİ</span>

        <h2>Hesabınızı yönetin</h2>

        <p>
            Güvenlik işlemlerinizi yönetin.
        </p>
    </div>

    <div class="account-management-grid">

        

        <!-- Şifre değiştirme -->
        <div class="account-action-card">
            <h3>Şifre Değiştir</h3>

            <p>
                Mevcut şifrenizi güvenli şekilde yenileyin.
            </p>

            <a asp-area="Identity"
               asp-page="/Account/Manage/ChangePassword">
                Şifreyi Değiştir →
            </a>
        </div>

        <!-- Çıkış -->
        <div class="account-action-card">
            <h3>Güvenli Çıkış</h3>

            <p>
                Hesabınızdan güvenli şekilde çıkış yapın.
            </p>

            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                  method="post">

                <button type="submit">
                    Çıkış Yap →
                </button>
            </form>
        </div>

    </div>

</section>
</div>