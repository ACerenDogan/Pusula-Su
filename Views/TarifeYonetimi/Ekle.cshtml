@model PusulaSu.Models.Tarife

@{
    ViewData["Title"] = "Yeni Tarife Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="mb-1">Yeni Tarife Ekle</h1>
            <p class="text-muted">
                Yeni dönem ve tüketim kademesi bilgilerini girin.
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Ekle" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Yil" class="form-label">
                                Yıl
                            </label>

                            <input asp-for="Yil"
                                   class="form-control"
                                   min="2026" />

                            <span asp-validation-for="Yil"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Ay" class="form-label">
                                Ay
                            </label>

                            <input asp-for="Ay"
                                   class="form-control"
                                   min="1"
                                   max="12" />

                            <span asp-validation-for="Ay"
                                  class="text-danger"></span>
                        </div>
                        <!-- Tarifenin ilan edildiği tarih -->
<div class="mb-3">
    <label asp-for="YayinTarihi" class="form-label">
        Yayın Tarihi
    </label>

    <input asp-for="YayinTarihi"
           type="date"
           class="form-control" />

    <span asp-validation-for="YayinTarihi"
          class="text-danger"></span>

    <div class="form-text">
        Tarife, yayın tarihinden sonraki gün uygulanmaya başlar.
    </div>
</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AboneTuru" class="form-label">
                            Abone Türü
                        </label>

                        <input asp-for="AboneTuru"
                               class="form-control"
                               placeholder="Örneğin: Mesken" />

                        <span asp-validation-for="AboneTuru"
                              class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="AltSinir" class="form-label">
                                Alt Sınır (m³)
                            </label>

                            <input asp-for="AltSinir"
       class="form-control"
       type="text"
       inputmode="decimal" />

                            <span asp-validation-for="AltSinir"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="UstSinir" class="form-label">
                                Üst Sınır (m³)
                            </label>

                            <input asp-for="UstSinir"
       class="form-control"
       type="text"
       inputmode="decimal" />

                            <div class="form-text">
                                Son kademe sınırsızsa boş bırakın.
                            </div>

                            <span asp-validation-for="UstSinir"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
    <label asp-for="SuBirimFiyati" class="form-label">
        Su Birim Fiyatı
    </label>

    <div class="input-group">
        <input asp-for="SuBirimFiyati"
               class="form-control"
               type="text"
               inputmode="decimal" />

        <span class="input-group-text">TL</span>
    </div>

    <span asp-validation-for="SuBirimFiyati"
          class="text-danger"></span>
</div>

                        <div class="col-md-6 mb-4">
    <label asp-for="AtikSuBirimFiyati" class="form-label">
        Atıksu Birim Fiyatı
    </label>

    <div class="input-group">
        <input asp-for="AtikSuBirimFiyati"
               class="form-control"
               type="text"
               inputmode="decimal" />

        <span class="input-group-text">TL</span>
    </div>

    <span asp-validation-for="AtikSuBirimFiyati"
          class="text-danger"></span>
</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Tarifeyi Kaydet
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

