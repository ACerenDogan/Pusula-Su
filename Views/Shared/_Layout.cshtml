<!DOCTYPE html>

<html lang="tr">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PusulaSu</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/PusulaSu.styles.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 bg-light">

    <!-- =====================================================
     ORTAK ÜST MENÜ
     Bütün sayfalarda görünür ve mobil cihazlara uyumludur.
     ===================================================== -->
<header class="pusulasu-site-header sticky-top">

    <nav class="navbar navbar-expand-lg navbar-light pusulasu-navbar">

        <div class="container">

            <!-- Logo ve proje adı -->
            <a class="navbar-brand pusulasu-brand"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">

                <span class="pusulasu-brand-icon">
                    PS
                </span>

                <span class="pusulasu-brand-copy">
                    <strong>PusulaSu</strong>
                    <small>Akıllı Su Takibi</small>
                </span>

            </a>

            <!-- Mobil menü butonu -->
            <button class="navbar-toggler pusulasu-menu-toggle collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#anaMenu"
                    aria-controls="anaMenu"
                    aria-expanded="false"
                    aria-label="Menüyü aç veya kapat">

                <span></span>
                <span></span>
                <span></span>

            </button>

            <!-- Açılıp kapanabilen menü -->
            <div id="anaMenu"
                 class="collapse navbar-collapse pusulasu-navbar-collapse">

                <!-- Sol taraftaki sayfa bağlantıları -->
                <ul class="navbar-nav pusulasu-main-links me-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="Index">
                            Ana Sayfa
                        </a>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="TarifeYonetimi"
                                   asp-action="Index">
                                    Tarife Yönetimi
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Tüketim Paneli
                                </a>
                            </li>
                        }
                    }

                </ul>

                <!-- Sağ taraf: bildirim ve kullanıcı işlemleri -->
                <div class="pusulasu-navbar-actions">

                    @if (User.Identity?.IsAuthenticated == true &&
                         !User.IsInRole("Admin"))
                    {
                        @await Component.InvokeAsync("Bildirim")
                    }

                    <partial name="_LoginPartial" />

                </div>

            </div>

        </div>

    </nav>

</header>

    <main class="container flex-grow-1 py-4">
        @RenderBody()
    </main>

    <footer class="pusulasu-footer bg-white border-top mt-auto">
        <div class="container py-4">

            <div class="d-flex flex-column flex-md-row
                        justify-content-between
                        align-items-md-center gap-2">

                <div>
                    <strong>PusulaSu</strong>

                    <span class="text-muted">
                        — Akıllı Su Tüketim Takibi
                    </span>
                </div>

                <div class="text-muted small">
                    © @DateTime.Now.Year PusulaSu
                </div>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>