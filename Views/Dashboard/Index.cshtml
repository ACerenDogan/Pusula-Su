@model PusulaSu.Models.DashboardViewModel

@{
    ViewData["Title"] = "Abone Paneli";
}

<!-- PANEL ÜST BÖLÜMÜ -->
<section class="dashboard-header mb-4">

    <div class="dashboard-header-content">

        <span class="manual-entry-badge">
    Tüketim Paneli
</span>


        <h1>
            Hoş geldiniz, @Model.Abone.AdSoyad
        </h1>

    </div>

    <!-- ABONELİK BİLGİLERİ -->
</section>

<!-- Yeni sayaç okuması -->
<div class="dashboard-entry-card mb-4">
    <div class="card-body p-4">

        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <div>
                <h2 class="h4 fw-bold mb-1">
                    Yeni Sayaç Okuması
                </h2>

                <p class="text-muted mb-0">
                    Sayacınızda görünen güncel endeksi girin.
                </p>
            </div>

            <span class="manual-entry-badge">
    Manuel Kayıt
</span>
        </div>

        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger mt-3">
                @TempData["Hata"]
            </div>
        }
        @if (TempData["Basari"] != null)
{
    <div class="alert alert-success mt-3">
        @TempData["Basari"]
    </div>
}
@{
    // En son kaydedilen sayaç endeksini bulur.
    var sonKayitliEndeks = Model.Abone.SayacOkumalari
        .OrderByDescending(o => o.Tarih)
        .ThenByDescending(o => o.Id)
        .FirstOrDefault()?.Endeks;

    // Kayıt yoksa çizgi, varsa altı haneli endeks gösterilir.
    string sayacGosterimi = sonKayitliEndeks.HasValue
        ? Math.Truncate(sonKayitliEndeks.Value).ToString("000000")
        : "------";
}

<!-- CANLI SAYAÇ GÖRÜNÜMÜ -->
<div class="water-meter-card dashboard-meter-card mb-4">

    <div class="meter-card-header">
        <span class="meter-card-label">
            CANLI SAYAÇ GÖRÜNÜMÜ
        </span>

        <span class="meter-card-status">
            <span></span>
            Güncel
        </span>
    </div>

    <!-- Yavaşça dönen sayaç -->
    <div class="meter-face dashboard-meter-face">

        <div class="meter-rotating-ring"
             aria-hidden="true">
        </div>

        <div class="meter-face-inner">
            <span class="meter-drop">◉</span>
            <strong>SU SAYACI</strong>
            <small>m³</small>
        </div>

    </div>

    <!-- Endeks rakamları -->
    <div id="canliSayacEndeksi"
         class="meter-number meter-flip-number"
         data-baslangic="@sayacGosterimi">

        @foreach (char rakam in sayacGosterimi)
        {
            <span class="sayac-rakam">@rakam</span>
        }

        <small>m³</small>
    </div>

    <p class="meter-example-note">
        Endeks alanına yazdığınız değer burada anlık görüntülenir.
    </p>

</div>
        <form asp-controller="Dashboard"
              asp-action="OkumaEkle"
              method="post"
              class="mt-4">

            @Html.AntiForgeryToken()

            <div class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label for="tarih" class="form-label">
                        Okuma Tarihi
                    </label>

                    <input id="tarih"
                           name="tarih"
                           type="date"
                           class="form-control"
                           value="@(DateTime.Today.ToString("yyyy-MM-dd"))"
                           required />
                </div>

                <div class="col-md-5">
                    <label for="endeks" class="form-label">
                        Sayaç Endeksi (m³)
                    </label>

                    <input id="endeks"
                           name="endeks"
                           type="number"
                           step="0.01"
                           min="0"
                           max="999999"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit"
        class="dashboard-save-button">
    Okumayı Kaydet
</button>
                </div>

            </div>
        </form>
    </div>
</div>

<!-- Tüketim ve tahmini bedel -->
@if (Model.AylikSuTuketimi > 0)
{
    <div class="consumption-summary mb-4">

        <div class="mb-3">
            <h2 class="h4 fw-bold mb-1">
                Tüketim Özeti
            </h2>

            <p class="text-muted mb-0">
                Girilen sayaç okumalarına göre hesaplanmıştır.
            </p>
        </div>

        <div class="row g-3">

            <div class="col-sm-6 col-lg-3">
                <div class="consumption-stat-card h-100">
                    <div class="card-body">
                        <div class="text-muted small mb-2">
                            TARİFE DÖNEMİ
                        </div>

                        <div class="fs-4 fw-semibold">
                            @Model.TarifeDönemi
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="consumption-stat-card h-100">
                    <div class="card-body">
                        <div class="text-muted small mb-2">
                            SU TÜKETİMİ
                        </div>

                        <div class="fs-4 fw-semibold">
                            @Model.AylikSuTuketimi.ToString("N2") m³
                        </div>
                    </div>
                </div>
            </div>

                        @if (Model.TarifeBulundu)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="consumption-stat-card h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-2">
                                SU BEDELİ
                            </div>

                            <div class="fs-4 fw-semibold">
                                @Model.SuBedeli.ToString("N2") TL
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <div class="consumption-stat-card h-100">
                        <div class="card-body">
                            <div class="text-muted small mb-2">
                                ATIKSU BEDELİ
                            </div>

                            <div class="fs-4 fw-semibold">
                                @Model.AtikSuBedeli.ToString("N2") TL
                            </div>
                        </div>
                    </div>
                </div>
<div class="col-12">
    <div class="consumption-stat-card">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-4">
                    <span class="consumption-stat-label">ÇTV</span>
                    <strong class="consumption-stat-value">
                        @Model.Ctv.ToString("N2") TL
                    </strong>
                </div>

                <div class="col-md-4">
                    <span class="consumption-stat-label">Su KDV (%1)</span>
                    <strong class="consumption-stat-value">
                        @Model.SuKdv.ToString("N2") TL
                    </strong>
                </div>

                <div class="col-md-4">
                    <span class="consumption-stat-label">Atıksu KDV (%10)</span>
                    <strong class="consumption-stat-value">
                        @Model.AtikSuKdv.ToString("N2") TL
                    </strong>
                </div>

            </div>
        </div>
    </div>
</div>
                <div class="col-12">
                    <div class="total-cost-card">
                        <div class="card-body p-4
                                    d-flex flex-column flex-md-row
                                    justify-content-between align-items-md-center">

                            <div>
                                <div class="small opacity-75">
                                    TAHMİNİ TOPLAM BEDEL
                                </div>

                                <div class="small opacity-75">
                                    Su, atıksu, ÇTV ve hesaplanan KDV tutarları dahildir.
                                </div>
                            </div>

                            <div class="display-6 fw-bold mt-3 mt-md-0">
                                @Model.ToplamBedel.ToString("N2") TL
                            </div>

                        </div>
                    </div>
                </div>
            }
            @if (Model.DonemKapatilabilir && Model.TarifeBulundu)
{
    <div class="col-12">
        <div class="d-flex justify-content-end">
            <form asp-controller="Dashboard"
                  asp-action="DonemiKapat"
                  method="post"
                  onsubmit="return confirm('Bu tüketim dönemini kapatmak istediğinize emin misiniz?');">

                @Html.AntiForgeryToken()

                <button type="submit" class="dashboard-save-button">
                    Dönemi Kapat
                </button>
            </form>
        </div>
    </div>
}
            
            else
            {
                <div class="col-12">
                    <div class="alert alert-warning mb-0">
                        Bu dönem için uygun tarife bulunamadı.
                    </div>
                </div>
            }

        </div>
    </div>
}
@if (Model.SonKapatilanDonem != null)
{
    <div class="col-12">
        <div class="d-flex justify-content-end">
            <form asp-controller="Dashboard"
                  asp-action="SonDonemiGeriAl"
                  method="post"
                  onsubmit="return confirm('Son kapatılan dönemi geri almak istediğinize emin misiniz?');">

                @Html.AntiForgeryToken()

                <button type="submit"
        class="dashboard-save-button">
    Son Dönemi Geri Al
</button>
            </form>
        </div>
    </div>
}
<!-- KAPANAN SON DÖNEMİN MİNİMAL FATURA ÖZETİ -->
@if (Model.Abone.SayacOkumalari.Count >= 2 && Model.AylikSuTuketimi == 0)
{
    var okumalarList = Model.Abone.SayacOkumalari.OrderBy(o => o.Tarih).ToList();
    var sonFaturaOkumasi = okumalarList.LastOrDefault(o => o.ToplamBedel.HasValue);
    
    if (sonFaturaOkumasi != null)
    {
        var onceki = okumalarList.ElementAtOrDefault(okumalarList.IndexOf(sonFaturaOkumasi) - 1);
        if (onceki != null)
        {
            decimal sonTuketim = sonFaturaOkumasi.Endeks - onceki.Endeks;
            decimal ctv = sonTuketim * 4.00m;
            decimal kalan = (sonFaturaOkumasi.ToplamBedel ?? 0) - ctv;

            <div class="card border-0 mb-4" style="background-color: #f4f9f9; border-radius: 16px;">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                        
                        <div class="mb-3 mb-md-0">
                            <span class="badge bg-white text-secondary border mb-2 px-2 py-1 shadow-sm">
                                Son Kesilen Fatura (@onceki.Tarih.ToString("dd.MM.yyyy") - @sonFaturaOkumasi.Tarih.ToString("dd.MM.yyyy"))
                            </span>
                            <div class="d-flex gap-4 mt-2">
                                <div>
                                    <span class="d-block text-muted" style="font-size: 0.75rem;">Su, Atıksu ve KDV</span>
                                    <strong class="text-dark">@kalan.ToString("N2") ₺</strong>
                                </div>
                                <div>
                                    <span class="d-block text-muted" style="font-size: 0.75rem;">ÇTV Tutarı</span>
                                    <strong class="text-dark">@ctv.ToString("N2") ₺</strong>
                                </div>
                            </div>
                        </div>

                        <div class="text-md-end border-start-md ps-md-4 mt-3 mt-md-0">
                            <span class="d-block text-muted mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">TOPLAM FATURA BEDELİ</span>
                            <strong class="display-6 fw-bold text-success" style="font-size: 1.8rem;">
                                @((sonFaturaOkumasi.ToplamBedel ?? 0).ToString("N2")) ₺
                            </strong>
                        </div>

                    </div>
                </div>
            </div>
        }
    }
}
<!-- Geçmiş okumalar -->
<div class="reading-history-card mb-4">
    <div class="card-body p-4">

        <div class="mb-3">
            <h2 class="h4 fw-bold mb-1">
                Geçmiş Sayaç Okumaları
            </h2>

            <p class="text-muted mb-0">
                Daha önce kaydettiğiniz sayaç değerleri.
            </p>
        </div>

        @if (Model.Abone.SayacOkumalari.Count == 0)
        {
            <div class="text-center text-muted py-5">
                Henüz sayaç okuması girilmemiştir.
            </div>
        }
        else
        {
            var okumalar = Model.Abone.SayacOkumalari
                .OrderBy(o => o.Tarih)
                .ToList();
                var sonOkumaId = okumalar.Last().Id;

            <div class="table-responsive">
                <table class="table align-middle mb-0 reading-history-table">

                    <thead>
                        <tr>
                           <th>Tarih</th>
                            <th>Endeks</th>
                            <th>Tüketim</th>
                            <th>Bedeli</th>
                            <th>İşlem</th>
                            
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = okumalar.Count - 1; i >= 0; i--)
                        {
                            var okuma = okumalar[i];

                            decimal? tuketim = i > 0
                                ? okuma.Endeks - okumalar[i - 1].Endeks
                                : null;

                            <tr>
                                <td>
                                    @okuma.Tarih.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    <strong>
                                        @okuma.Endeks.ToString("0.##") m³
                                    </strong>
                                </td>

                                <td>
                                    @if (tuketim.HasValue)
                                    {
                                        <span class="reading-consumption-badge">
                                            @tuketim.Value.ToString("0.##") m³
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="reading-first-badge">
                                            İlk okuma
                                        </span>
                                    }
                                </td>
                                <td>
    @if (okuma.ToplamBedel.HasValue)
    {
        <span class="badge bg-success" style="font-size:0.9rem; padding: 0.5em 0.8em;">
            @okuma.ToplamBedel.Value.ToString("N2") ₺
        </span>
    }
    else if (i == 0)
    {
        <span class="text-muted small">İlk Kayıt</span>
    }
    else
    {
        <span class="text-muted small">Tarife Bulunamadı</span>
    }
</td>
<td>
    @if (okuma.Id == sonOkumaId)
    {
        <form asp-controller="Dashboard"
              asp-action="SonOkumayiSil"
              asp-route-id="@okuma.Id"
              method="post"
              class="d-inline"
              onsubmit="return confirm('Son sayaç okumasını silmek istediğinize emin misiniz?');">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-danger btn-sm">
                Yanlış Girdim
            </button>
        </form>
    }
    else
    {
        <span class="text-muted">—</span>
    }
</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>
</div>
<!-- GEÇMİŞ FATURALAR KARTI -->
<div class="reading-history-card mb-4">
    <div class="card-body p-4">

        <div class="mb-4">
            <h2 class="h4 fw-bold mb-1">Geçmiş Faturalar</h2>
            <p class="text-muted mb-0">
                Kaydettiğiniz dönemlere ait vergiler dahil hesaplanan fatura tutarları.
            </p>
        </div>

                @if (Model.Abone.TuketimDonemleri.Count == 0)
        {
            <div class="text-center text-muted py-5">
                Henüz hesaplanmış bir geçmiş fatura bulunmuyor.
            </div>
        }
        else
        {
            // İptal edilmemiş faturaları yeniden eskiye sırala
            var faturalar = Model.Abone.TuketimDonemleri
                .Where(d => !d.IptalEdildi)
                .OrderByDescending(d => d.KapatilmaTarihi)
                .ToList();
            
            <div class="list-group list-group-flush">
                @foreach (var donem in faturalar)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 border-bottom">
                        <div>
                            <strong class="fs-5 text-dark">
                                @donem.BaslangicTarihi.ToString("dd.MM.yyyy") - @donem.BitisTarihi.ToString("dd.MM.yyyy")
                            </strong>
                            <div class="text-muted small mt-1">
                                Toplam Tüketim: <span class="fw-semibold text-dark">@donem.ToplamTuketim.ToString("0.##") m³</span>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-success rounded-pill px-3 py-2 fs-6">
                                @donem.ToplamBedel.ToString("N2") ₺
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>